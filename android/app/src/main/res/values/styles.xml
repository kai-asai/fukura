<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/grouped_background</item>
        <item name="android:navigationBarColor">@color/grouped_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/grouped_background</item>
        <item name="android:colorAccent">@color/link_blue</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/label_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>
